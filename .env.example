# Copy to .env and fill in. Never commit .env.

FLASK_APP=app
SECRET_KEY=change-me-to-a-long-random-string

# MySQL connection (PyMySQL driver)
DATABASE_URL=mysql+pymysql://app_user:app_password@localhost:3306/sales_inventory
TEST_DATABASE_URL=mysql+pymysql://app_user:app_password@localhost:3306/sales_inventory_test

# Sample accounts created by scripts/seed.py
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_SALES_EMAIL=sales1@example.com
SEED_SALES_PASSWORD=change-me
SEED_SALES2_EMAIL=sales2@example.com
SEED_SALES2_PASSWORD=change-me
